<Page
    x:Class="LaserControllerApp.Views.PulseSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LaserControllerApp.ViewModels"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid Margin="20">
        <StackPanel Spacing="15">
            <TextBlock Text="PULSE SETTINGS" 
                       FontSize="18" 
                       FontWeight="Bold" />

            <StackPanel Orientation="Vertical" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Pulse Width (ns)" Width="150"/>
                    <TextBox Text="{x:Bind ViewModel.PulseWidth, Mode=TwoWay}" Width="100"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Frequency (Hz)" Width="150"/>
                    <TextBox Text="{x:Bind ViewModel.Frequency, Mode=TwoWay}" Width="100"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Voltage (V)" Width="150"/>
                    <TextBox Text="{x:Bind ViewModel.Voltage, Mode=TwoWay}" Width="100"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Apply Settings" Click="ApplySettings_Click"/>
                <Button Content="Refresh" Click="Refresh_Click"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" FontSize="12" Foreground="Gray" Text="Idle"/>
        </StackPanel>
    </Grid>
</Page>
