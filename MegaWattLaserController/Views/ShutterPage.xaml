<Page
    x:Class="LaserControllerApp.Views.ShutterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LaserControllerApp.ViewModels"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid Margin="20">
        <StackPanel Spacing="15">
            <TextBlock Text="SHUTTER CONTROL" 
                       FontSize="18" 
                       FontWeight="Bold"/>

            <TextBlock Text="Current Shutter State:" FontSize="14"/>
            <TextBlock x:Name="ShutterStatusText"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="DarkBlue"
                       Text="Unknown"/>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="OpenShutterButton" Content="Open Shutter" Click="OpenShutter_Click"/>
                <Button x:Name="CloseShutterButton" Content="Close Shutter" Click="CloseShutter_Click"/>
            </StackPanel>

            <Button x:Name="RefreshButton" Content="Refresh Status" Click="RefreshStatus_Click"/>

            <TextBlock x:Name="StatusText" FontSize="12" Foreground="Gray" Text="Idle"/>
        </StackPanel>
    </Grid>
</Page>
