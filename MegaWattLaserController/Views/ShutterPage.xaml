<Page x:Class="LaserControllerApp.Views.ShutterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Unloaded="Page_Unloaded">

    <Grid Margin="20">
        <StackPanel Spacing="15">
            <TextBlock Text="SHUTTER CONTROL" 
                       FontSize="16" 
                       FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="OpenShutterButton"
                        Content="Open Shutter" 
                        Click="OpenShutter_Click" 
                        Width="120"/>

                <Button x:Name="CloseShutterButton"
                        Content="Close Shutter" 
                        Click="CloseShutter_Click"
                        Width="120"/>
            </StackPanel>

            <InfoBar x:Name="StatusInfoBar" 
                     Title="Shutter Status"
                     IsOpen="False"
                     HorizontalAlignment="Stretch"/>

            <TextBlock x:Name="StatusTextBlock" 
                       Text="Shutter status unknown"
                       FontStyle="Italic"
                       Foreground="{ThemeResource SystemBaseMediumHighColor}"/>

            <TextBlock Text="Note: Shutter is external to laser driver" 
                       Foreground="Gray" 
                       FontSize="12"
                       FontStyle="Italic"/>
        </StackPanel>
    </Grid>
</Page>