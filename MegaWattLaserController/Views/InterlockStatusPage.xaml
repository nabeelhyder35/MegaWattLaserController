<Page x:Class="LaserControllerApp.Views.InterlockStatusPage"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LaserControllerApp"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    >

    <Page.Resources>
        <Style x:Key="InterlockItemStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <Style x:Key="StatusIndicatorStyle" TargetType="Border">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="GoodStatusStyle" TargetType="Border" BasedOn="{StaticResource StatusIndicatorStyle}">
            <Setter Property="Background" Value="Green"/>
        </Style>

        <Style x:Key="FaultStatusStyle" TargetType="Border" BasedOn="{StaticResource StatusIndicatorStyle}">
            <Setter Property="Background" Value="Red"/>
        </Style>

        <Style x:Key="RecoveredStatusStyle" TargetType="Border" BasedOn="{StaticResource StatusIndicatorStyle}">
            <Setter Property="Background" Value="Yellow"/>
        </Style>

        <Style x:Key="DisabledStatusStyle" TargetType="Border" BasedOn="{StaticResource StatusIndicatorStyle}">
            <Setter Property="Background" Value="Gray"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <ScrollViewer>
            <StackPanel>
                <!-- Header -->
                <Border Background="{StaticResource SystemAccentColorDark2}" 
                        CornerRadius="8" 
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="INTERLOCK STATUS" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Current interlock status and historical fault monitoring"
                                   FontSize="12"
                                   Foreground="White"
                                   Opacity="0.8"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Interlock Status Grid -->
                <Border Background="{StaticResource SystemControlBackgroundBaseLowBrush}" 
                        CornerRadius="8" 
                        Padding="20"
                        Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="INTERLOCK STATUS MONITORING" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <!-- Coolant Flow -->
                        <Grid Style="{StaticResource InterlockItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CoolantFlowIndicator" Style="{StaticResource GoodStatusStyle}"/>

                            <TextBlock Text="Coolant Flow" 
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="CoolantFlowStatus" 
                                       Text="GOOD" 
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Foreground="Green"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <!-- Coolant Temp -->
                        <Grid Style="{StaticResource InterlockItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CoolantTempIndicator" Style="{StaticResource GoodStatusStyle}"/>

                            <TextBlock Text="Coolant Temperature" 
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="CoolantTempStatus" 
                                       Text="GOOD" 
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Foreground="Green"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <!-- Door Cover -->
                        <Grid Style="{StaticResource InterlockItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="DoorCoverIndicator" Style="{StaticResource GoodStatusStyle}"/>

                            <TextBlock Text="Door Cover" 
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="DoorCoverStatus" 
                                       Text="GOOD" 
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Foreground="Green"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <!-- Charger Over-Voltage -->
                        <Grid Style="{StaticResource InterlockItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="ChargerVoltageIndicator" Style="{StaticResource GoodStatusStyle}"/>

                            <TextBlock Text="Charger Over-Voltage" 
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="ChargerVoltageStatus" 
                                       Text="GOOD" 
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Foreground="Green"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <!-- Charger Over-Temperature -->
                        <Grid Style="{StaticResource InterlockItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="ChargerTempIndicator" Style="{StaticResource GoodStatusStyle}"/>

                            <TextBlock Text="Charger Over-Temperature" 
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="ChargerTempStatus" 
                                       Text="GOOD" 
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Foreground="Green"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <!-- Additional Interlocks 6-8 -->
                        <Grid Style="{StaticResource InterlockItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Interlock6Indicator" Style="{StaticResource DisabledStatusStyle}"/>

                            <TextBlock Text="Interlock 6" 
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="Interlock6Status" 
                                       Text="DISABLED" 
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Style="{StaticResource InterlockItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Interlock7Indicator" Style="{StaticResource DisabledStatusStyle}"/>

                            <TextBlock Text="Interlock 7" 
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="Interlock7Status" 
                                       Text="DISABLED" 
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Style="{StaticResource InterlockItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Interlock8Indicator" Style="{StaticResource DisabledStatusStyle}"/>

                            <TextBlock Text="Interlock 8" 
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="Interlock8Status" 
                                       Text="DISABLED" 
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Control Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
                    <Button x:Name="RefreshButton" 
                            Content="Refresh Status" 
                            Click="RefreshButton_Click"
                            Margin="0,0,10,0"/>

                    <Button x:Name="ResetFaultsButton" 
                            Content="Reset Historical Faults" 
                            Click="ResetFaultsButton_Click"/>
                </StackPanel>

                <!-- Status Legend -->
                <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" 
                        CornerRadius="8" 
                        Padding="15"
                        Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="STATUS LEGEND" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource GoodStatusStyle}" VerticalAlignment="Center"/>
                                <TextBlock Text="Good - No faults detected" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource FaultStatusStyle}" VerticalAlignment="Center"/>
                                <TextBlock Text="Fault - Active interlock fault" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource RecoveredStatusStyle}" VerticalAlignment="Center"/>
                                <TextBlock Text="Recovered - Historical fault (now good)" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource DisabledStatusStyle}" VerticalAlignment="Center"/>
                                <TextBlock Text="Disabled - Interlock not configured" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>