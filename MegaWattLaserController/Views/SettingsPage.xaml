<Page
    x:Class="LaserControllerApp.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LaserControllerApp.ViewModels"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid Margin="20">
        <StackPanel Spacing="15">
            <TextBlock Text="APPLICATION SETTINGS" 
                       FontSize="18" 
                       FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Serial Port:" Width="120"/>
                <ComboBox x:Name="PortComboBox"
                          Width="150"
                          ItemsSource="{x:Bind ViewModel.AvailablePorts}"
                          SelectedItem="{x:Bind ViewModel.SelectedPort, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Baud Rate:" Width="120"/>
                <ComboBox x:Name="BaudRateComboBox"
                          Width="150"
                          SelectedItem="{x:Bind ViewModel.SelectedBaudRate, Mode=TwoWay}">
                    <ComboBoxItem Content="9600" Tag="9600"/>
                    <ComboBoxItem Content="19200" Tag="19200"/>
                    <ComboBoxItem Content="38400" Tag="38400"/>
                    <ComboBoxItem Content="57600" Tag="57600"/>
                    <ComboBoxItem Content="115200" Tag="115200"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Connect" Click="Connect_Click"/>
                <Button Content="Disconnect" Click="Disconnect_Click"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" FontSize="12" Foreground="Gray" Text="Idle"/>
        </StackPanel>
    </Grid>
</Page>
