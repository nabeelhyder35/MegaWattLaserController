<Page
    x:Class="LaserControllerApp.Views.WaveformPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LaserControllerApp.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.DataContext>
        <vm:WaveformViewModel />
    </Page.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10">
            <Button Content="Start" Click="StartMonitoring_Click" />
            <Button Content="Stop" Click="StopMonitoring_Click" />
            <Button Content="Reset Zoom" Click="ResetZoom_Click" Margin="5"/>
            <ComboBox x:Name="TimeScaleComboBox" Width="150" SelectionChanged="TimeScaleComboBox_SelectionChanged">
                <ComboBoxItem Content="1s"/>
                <ComboBoxItem Content="5s"/>
                <ComboBoxItem Content="10s"/>
            </ComboBox>
        </StackPanel>

        <!-- Chart placeholder -->
        <Border Grid.Row="1" Background="Black" Margin="10">
            <TextBlock Text="Waveform Chart Area" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="Ready" Margin="10"/>
    </Grid>
</Page>
