<Window
    x:Class="LaserControllerApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LaserControllerApp"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="Laser Controller"
    Closed="Window_Closed">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar - Connection Controls -->
        <Border Grid.Row="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}" 
                Padding="16,12"
                BorderThickness="0,0,0,1" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">

                <!-- Port Selection -->
                <StackPanel Orientation="Vertical" Spacing="4" MinWidth="180">
                    <TextBlock Text="COM Port"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ComboBox ItemsSource="{Binding AvailablePorts, Mode=OneWay}"
                              SelectedItem="{Binding SelectedPort, Mode=TwoWay}"
                              PlaceholderText="Select COM Port"
                              IsEnabled="{Binding IsNotConnected, Mode=OneWay}"
                              CornerRadius="4"/>
                </StackPanel>

                <!-- Baud Rate Selection -->
                <StackPanel Orientation="Vertical" Spacing="4" MinWidth="120">
                    <TextBlock Text="Baud Rate"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ComboBox ItemsSource="{Binding BaudRates, Mode=OneWay}"
                              SelectedItem="{Binding SelectedBaudRate, Mode=TwoWay}"
                              IsEnabled="{Binding IsNotConnected, Mode=OneWay}"
                              CornerRadius="4"/>
                </StackPanel>

                <!-- Connection Controls -->
                <Button Content="⟳ Refresh Ports"
                        Command="{Binding RefreshPortsCommand}"
                        ToolTipService.ToolTip="Refresh available serial ports"
                        Style="{StaticResource SecondaryButtonStyle}"
                        CornerRadius="4"/>

                <Button Content="🔗 Connect"
                        Command="{Binding ConnectCommand}"
                        IsEnabled="{Binding CanConnect, Mode=OneWay}"
                        Background="{ThemeResource SystemAccentColor}"
                        Foreground="White"
                        ToolTipService.ToolTip="Connect to selected serial port"
                        CornerRadius="4"
                        FontWeight="SemiBold"/>

                <Button Content="⏏ Disconnect"
                        Command="{Binding DisconnectCommand}"
                        IsEnabled="{Binding IsConnected, Mode=OneWay}"
                        Background="{ThemeResource SystemFillColorCriticalBrush}"
                        Foreground="White"
                        ToolTipService.ToolTip="Disconnect from serial port"
                        CornerRadius="4"
                        FontWeight="SemiBold"/>

                <!-- Connection Status Indicator -->
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            Padding="12,8"
                            CornerRadius="6">
                    <Border Width="10"
                            Height="10"
                            CornerRadius="5"
                            Background="{Binding ConnectionStatusColor, Mode=OneWay}"/>
                    <StackPanel Orientation="Vertical" Spacing="2">
                        <TextBlock Text="{Binding CurrentState, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>
                        <TextBlock Text="Connection Status"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Laser Control Dashboard -->
        <Border Grid.Row="1"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <ContentControl x:Name="DashboardContent"/>
        </Border>

        <!-- Error Bar -->
        <Border Grid.Row="2"
                Background="{ThemeResource SystemFillColorCriticalBrush}"
                Padding="16,12"
                CornerRadius="4"
                Margin="12"
                BorderBrush="{ThemeResource SystemAccentColor}"
                Visibility="{Binding HasError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE783;" Foreground="White" FontSize="16"/>
                    <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}"
                               Foreground="White"
                               FontWeight="Medium"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Dismiss"
                        Click="DismissErrorButton_Click"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="White"
                        CornerRadius="4"
                        MinWidth="80"
                        Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>