<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>LaserControllerApp</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
		<Platforms>x86;x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<UseWinUI>true</UseWinUI>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<WindowsPackageType>None</WindowsPackageType>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Assets\AppIcon.ico" />
	</ItemGroup>

	<ItemGroup>
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Windows App SDK (Use consistent version) -->
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240428000" />

		<!-- MVVM Toolkit -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />

		<!-- Serial Port -->
		<PackageReference Include="System.IO.Ports" Version="8.0.0" />

		<!-- Dependency Injection -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />

		<!-- LiveChartsCore -->
		<PackageReference Include="LiveChartsCore.SkiaSharpView.WinUI" Version="2.0.0-rc5.3" />

		<!-- Remove these as they're included in the WinUI package -->
		<!-- <PackageReference Include="Microsoft.WinUI" Version="3.3.3" /> -->
		<!-- <PackageReference Include="LiveChartsCore.SkiaSharpView" Version="2.3.0" /> -->
		<!-- <PackageReference Include="LiveChartsCore" Version="2.3.0" /> -->
		<!-- <PackageReference Include="SkiaSharp" Version="2.88.3" /> -->
		<!-- <PackageReference Include="SkiaSharp.Views" Version="2.88.3" /> -->
	</ItemGroup>

	<ItemGroup>
		<Compile Update="ViewModels\*.cs" />
		<Compile Update="Models\*.cs" />
		<Compile Update="Services\*.cs" />
		<Compile Update="Views\*.xaml.cs" />
		<Compile Update="Converters\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<Page Update="Views\*.xaml" SubType="Designer" Generator="MSBuild:Compile" />
		<Page Update="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
		<Page Update="MainWindow.xaml" SubType="Designer" Generator="MSBuild:Compile" />
	</ItemGroup>

	<ItemGroup>
		<None Update="app.manifest" />
	</ItemGroup>

</Project>