<Application
    x:Class="LaserControllerApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:LaserControllerApp.Converters"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Required for WinUI 3 controls -->
                <muxc:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:BooleanToColorConverter x:Key="BooleanToColorConverter" 
                                   TrueColor="#FF107C10" 
                                   FalseColor="#FFE81123"/>
            <converters:NotEmptyToBooleanConverter x:Key="NotEmptyToBooleanConverter"/>
            <converters:ConnectionStatusConverter x:Key="ConnectionStatusConverter"/>
            <converters:BooleanToPauseResumeConverter x:Key="PauseResumeConverter"/>
            <converters:BooleanToStringConverter x:Key="ArmDisarmConverter"
                                    TrueValue="Disarm System"
                                    FalseValue="Arm System"/>
            <converters:BooleanToColorConverter x:Key="ArmDisarmColorConverter"
                                   TrueColor="#FFF44336"
                                   FalseColor="#FF4CAF50"/>          
           

            <!-- Styles -->
            <Style TargetType="Button" x:Key="PrimaryButtonStyle">
                <Setter Property="Background" Value="#FF0078D4"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <Style TargetType="Button" x:Key="SecondaryButtonStyle">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#FF0078D4"/>
                <Setter Property="BorderBrush" Value="#FF0078D4"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="4"/>
            </Style>

            <Style TargetType="Border" x:Key="CardStyle">
                <Setter Property="Background" Value="#FF212121"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#FF424242"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="6"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
