<Window x:ConnectionId='1'
    x:Class="LaserControllerApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LaserControllerApp"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="Laser Controller">

    <Grid x:ConnectionId='2' x:Name="RootGrid"                                               >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <StackPanel Orientation="Horizontal" Margin="8" Spacing="8">
            <ComboBox x:ConnectionId='7' Width="120"
                                                                                  
                                                                                 
                      PlaceholderText="Select Port"/>
            <ComboBox x:ConnectionId='8' Width="120"
                                                                             
                                                                                     />
            <Button x:ConnectionId='9' Content="Refresh"                                                 />
            <Button x:ConnectionId='10' Content="Connect"                                            />
            <Button x:ConnectionId='11' Content="Disconnect"                                               />
            <TextBlock x:ConnectionId='12'                                                     
                       FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- NavigationView -->
        <muxc:NavigationView x:ConnectionId='3' x:Name="NavigationViewControl"
                             Grid.Row="1"
                             PaneDisplayMode="Left"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="True"
                             PaneTitle="Laser Control"
                                                                                      >

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Energy Monitor" Tag="EnergyMonitorPage"/>
                <muxc:NavigationViewItem Content="Pulse Settings" Tag="PulseSettingsPage"/>
                <muxc:NavigationViewItem Content="Voltage Control" Tag="VoltagePage"/>
                <muxc:NavigationViewItem Content="Shutter Control" Tag="ShutterPage"/>
                <muxc:NavigationViewItem Content="Waveform Display" Tag="WaveformPage"/>
                <muxc:NavigationViewItem Content="Interlock Status" Tag="InterlockStatusPage"/>
                <muxc:NavigationViewItem Content="Custom Commands" Tag="CustomPage"/>
            </muxc:NavigationView.MenuItems>

            <Frame x:ConnectionId='6' x:Name="ContentFrame"/>
        </muxc:NavigationView>

        <!-- Error Bar -->
        <Border x:ConnectionId='4' Grid.Row="2" Background="DarkRed" Padding="8"
                                                                     >
            <TextBlock x:ConnectionId='5'                                                     Foreground="White" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>

