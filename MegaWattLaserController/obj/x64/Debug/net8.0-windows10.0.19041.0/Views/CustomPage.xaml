<Page x:Class="LaserControllerApp.Views.CustomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <StackPanel Spacing="15">
            <TextBlock Text="CUSTOM COMMANDS" 
                       FontSize="18" 
                       FontWeight="Bold"/>

            <ListView x:ConnectionId='2' x:Name="LogListView" Height="200">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox x:ConnectionId='3' x:Name="CommandTextBox" Width="300" PlaceholderText="Enter command..."/>
                <Button x:ConnectionId='4' x:Name="SendCommandButton" Content="Send"                          />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>

