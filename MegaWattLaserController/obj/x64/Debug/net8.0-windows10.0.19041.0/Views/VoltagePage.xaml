<Page x:ConnectionId='1'
    x:Class="LaserControllerApp.Views.VoltagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:vm="using:LaserControllerApp.ViewModels"
                        
                            >

    <Grid Margin="20">
        <StackPanel Spacing="15">
            <TextBlock Text="CAPACITOR VOLTAGE MONITOR" 
                       FontSize="18" 
                       FontWeight="Bold"/>

            <Border BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource SystemControlBackgroundAltHighBrush}">
                <lvc:CartesianChart x:ConnectionId='9'
                    x:Name="VoltageChart"
                    Height="300"
                    Series="{Binding Series}"
                    XAxes="{Binding XAxes}"
                    YAxes="{Binding YAxes}"
                    TooltipPosition="Hidden"/>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:ConnectionId='4' x:Name="StartButton" Content="Start Monitoring"                              />
                <Button x:ConnectionId='5' x:Name="StopButton" Content="Stop Monitoring"                             />
                <ComboBox x:ConnectionId='6' x:Name="TimeScaleComboBox" 
                          Width="100"
                          SelectedIndex="2"
                                                                               >
                    <ComboBoxItem Content="1s" Tag="1"/>
                    <ComboBoxItem Content="5s" Tag="5"/>
                    <ComboBoxItem Content="10s" Tag="10"/>
                </ComboBox>
                <Button x:ConnectionId='7' x:Name="ClearButton" Content="Clear Chart"                         />
                <Button x:ConnectionId='8' x:Name="ResetZoomButton" Content="Reset Zoom"                        />
            </StackPanel>

            <TextBlock x:ConnectionId='2' x:Name="CurrentVoltageText" FontSize="14" FontWeight="Bold" Text="Current Voltage: 0 V"/>
            <TextBlock x:ConnectionId='3' x:Name="StatusText" FontSize="12" Foreground="Gray" Text="Monitoring stopped"/>
        </StackPanel>
    </Grid>
</Page>

