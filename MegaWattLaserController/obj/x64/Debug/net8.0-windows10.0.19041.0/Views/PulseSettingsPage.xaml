<Page x:ConnectionId='1'
    x:Class="LaserControllerApp.Views.PulseSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LaserControllerApp.ViewModels"
                        
                            >

    <Grid Margin="20">
        <StackPanel Spacing="15">
            <TextBlock Text="PULSE SETTINGS" 
                       FontSize="18" 
                       FontWeight="Bold" />

            <StackPanel Orientation="Vertical" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Pulse Width (ns)" Width="150"/>
                    <TextBox x:ConnectionId='7'                                                   Width="100"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Frequency (Hz)" Width="150"/>
                    <TextBox x:ConnectionId='6'                                                  Width="100"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Voltage (V)" Width="150"/>
                    <TextBox x:ConnectionId='5'                                                Width="100"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:ConnectionId='3' Content="Apply Settings"                            />
                <Button x:ConnectionId='4' Content="Refresh"                      />
            </StackPanel>

            <TextBlock x:ConnectionId='2' x:Name="StatusText" FontSize="12" Foreground="Gray" Text="Idle"/>
        </StackPanel>
    </Grid>
</Page>

