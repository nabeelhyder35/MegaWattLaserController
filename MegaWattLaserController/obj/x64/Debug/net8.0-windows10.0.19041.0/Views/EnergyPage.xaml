<Page x:ConnectionId='1'
    x:Class="LaserControllerApp.Views.EnergyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:LaserControllerApp.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            >

    <Page.Resources>
        <converters:EnergyConverter x:Key="EnergyConverter" />
        <converters:TemperatureConverter x:Key="TemperatureConverter" />
        <converters:VoltageConverter x:Key="VoltageConverter" />
    </Page.Resources>

    <Grid Margin="20">
        <ScrollViewer>
            <StackPanel Spacing="20">
                <!-- Header -->
                <TextBlock Text="ENERGY MONITOR" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"/>

                <!-- Energy and Temperature Display -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" 
                        Padding="20">
                    <StackPanel Spacing="15">
                        <TextBlock Text="SENSOR READINGS" 
                                   FontSize="16" 
                                   FontWeight="Bold"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Energy -->
                            <TextBlock Text="Energy:"
                                       Grid.Row="0" Grid.Column="0"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:ConnectionId='7' x:Name="EnergyValueText"
                                       Text="0.00 mJ"
                                       Grid.Row="0" Grid.Column="1"
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Margin="10,0"
                                       VerticalAlignment="Center"/>

                            <Button x:ConnectionId='8' x:Name="ReadEnergyButton"
                                    Content="Read Energy"
                                                            
                                    Grid.Row="0" Grid.Column="2"
                                    Width="120"/>

                            <!-- Temperature -->
                            <TextBlock Text="Temperature:"
                                       Grid.Row="1" Grid.Column="0"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,10,0,0"/>

                            <TextBlock x:ConnectionId='9' x:Name="TemperatureValueText"
                                       Text="0.0 �C"
                                       Grid.Row="1" Grid.Column="1"
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Margin="10,10,0,0"
                                       VerticalAlignment="Center"/>

                            <Button x:ConnectionId='10' x:Name="ReadTemperatureButton"
                                    Content="Read Temperature"
                                                                 
                                    Grid.Row="1" Grid.Column="2"
                                    Width="120"
                                    Margin="0,10,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Voltage Control -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" 
                        Padding="20">
                    <StackPanel Spacing="15">
                        <TextBlock Text="VOLTAGE CONTROL" 
                                   FontSize="16" 
                                   FontWeight="Bold"/>

                        <Slider x:ConnectionId='4' x:Name="VoltageSlider"
                                Minimum="0" 
                                Maximum="1000" 
                                Value="300"
                                TickFrequency="50" 
                                IsThumbToolTipEnabled="True" 
                                TickPlacement="Outside"
                                                                         />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:ConnectionId='5' x:Name="VoltageValueText"
                                       Text="300 V"
                                       VerticalAlignment="Center" 
                                       FontWeight="SemiBold"/>

                            <Button x:ConnectionId='6' x:Name="SetVoltageButton"
                                    Content="Set Voltage" 
                                                             
                                    Grid.Column="1"
                                    Width="120"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Response Display -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" 
                        Padding="20">
                    <StackPanel Spacing="15">
                        <TextBlock Text="RESPONSE" 
                                   FontSize="16" 
                                   FontWeight="Bold"/>

                        <InfoBar x:ConnectionId='2' x:Name="StatusInfoBar" 
                                 Title="FPGA Response"
                                 IsOpen="False"
                                 HorizontalAlignment="Stretch"/>

                        <TextBlock x:ConnectionId='3' x:Name="StatusTextBlock" 
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas"
                                   Foreground="{ThemeResource SystemBaseMediumHighColor}"
                                   MinHeight="60"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

