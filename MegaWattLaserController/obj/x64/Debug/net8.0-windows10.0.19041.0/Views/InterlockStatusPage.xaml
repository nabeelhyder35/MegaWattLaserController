<Page x:ConnectionId='1'
    x:Class="LaserControllerApp.Views.InterlockStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LaserControllerApp.ViewModels"
                        
                            >

    <Grid Margin="20">
        <StackPanel Spacing="15">
            <TextBlock Text="INTERLOCK STATUS" 
                       FontSize="18" 
                       FontWeight="Bold" />

            <Border BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                    Padding="10">
                <ItemsControl ItemsSource="{Binding InterlockItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate                                       >
                            <StackPanel x:ConnectionId='6' Orientation="Horizontal" Spacing="10">
                                <TextBlock x:ConnectionId='7'                      Width="150"/>
                                <TextBlock x:ConnectionId='8'                                                         />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:ConnectionId='3' Content="Refresh"                      />
                <Button x:ConnectionId='4' Content="Clear Log"                       />
            </StackPanel>

            <TextBlock x:ConnectionId='2' x:Name="StatusText" FontSize="12" Foreground="Gray" Text="Idle"/>
        </StackPanel>
    </Grid>
</Page>

