<ContentDialog x:ConnectionId='1'
    x:Class="LaserControllerApp.Views.PulseSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pulse Settings"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
                                                         >

    <StackPanel Padding="12" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Voltage (V):" Width="120" VerticalAlignment="Center"/>
            <TextBox x:ConnectionId='6' x:Name="VoltageTextBox"
                                                             
                     Width="120"
                                                                           
                     InputScope="Number"/>
            <TextBlock Text="(0-2000V)" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Energy (J):" Width="120" VerticalAlignment="Center"/>
            <TextBox x:ConnectionId='5' x:Name="EnergyTextBox"
                                                            
                     Width="120"
                                                                           
                     InputScope="Number"/>
            <TextBlock Text="(0-10J)" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Pulse Width (µs):" Width="120" VerticalAlignment="Center"/>
            <TextBox x:ConnectionId='4' x:Name="PulseWidthTextBox"
                                                                
                     Width="120"
                                                                           
                     InputScope="Number"/>
            <TextBlock Text="(1-1000µs)" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Shots:" Width="120" VerticalAlignment="Center"/>
            <TextBox x:ConnectionId='3' x:Name="ShotsTextBox"
                                                           
                     Width="120"
                                                                           
                     InputScope="Number"/>
            <TextBlock Text="(1-9999)" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Frequency (Hz):" Width="120" VerticalAlignment="Center"/>
            <TextBox x:ConnectionId='2' x:Name="FrequencyTextBox"
                                                               
                     Width="120"
                                                                           
                     InputScope="Number"/>
            <TextBlock Text="(1-100Hz)" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>

