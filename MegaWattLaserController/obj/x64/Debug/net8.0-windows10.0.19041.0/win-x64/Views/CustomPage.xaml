<Page
    x:Class="LaserControllerApp.Views.CustomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LaserControllerApp.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20">
        <StackPanel Spacing="10">

            <TextBlock Text="Command ID (Hex or Number)" />
            <TextBox x:ConnectionId='2' x:Name="CommandIdTextBox" PlaceholderText="e.g. 01" />

            <TextBlock Text="Payload Data (Hex bytes)" />
            <TextBox x:ConnectionId='3' x:Name="DataTextBox" PlaceholderText="e.g. 01 0A FF" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:ConnectionId='5' Content="Send"                         />
                <Button x:ConnectionId='6' Content="Clear Log"                             />
            </StackPanel>

            <TextBlock Text="Log Messages:" Margin="0,10,0,0"/>
            <ListView x:ConnectionId='4' x:Name="LogListView" Height="200"/>
        </StackPanel>
    </Grid>
</Page>

