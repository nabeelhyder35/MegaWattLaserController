<Page x:ConnectionId='1'
    x:Class="LaserControllerApp.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LaserControllerApp.ViewModels"
                        
                            >

    <Grid Margin="20">
        <StackPanel Spacing="15">
            <TextBlock Text="APPLICATION SETTINGS" 
                       FontSize="18" 
                       FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Serial Port:" Width="120"/>
                <ComboBox x:ConnectionId='6' x:Name="PortComboBox"
                          Width="150"
                                                                         
                                                                                     />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Baud Rate:" Width="120"/>
                <ComboBox x:ConnectionId='5' x:Name="BaudRateComboBox"
                          Width="150"
                                                                                         >
                    <ComboBoxItem Content="9600" Tag="9600"/>
                    <ComboBoxItem Content="19200" Tag="19200"/>
                    <ComboBoxItem Content="38400" Tag="38400"/>
                    <ComboBoxItem Content="57600" Tag="57600"/>
                    <ComboBoxItem Content="115200" Tag="115200"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:ConnectionId='3' Content="Connect"                      />
                <Button x:ConnectionId='4' Content="Disconnect"                         />
            </StackPanel>

            <TextBlock x:ConnectionId='2' x:Name="StatusText" FontSize="12" Foreground="Gray" Text="Idle"/>
        </StackPanel>
    </Grid>
</Page>

