<Application
    x:Class="LaserControllerApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LaserControllerApp">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Merge WinUI 3 standard theme resources -->
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Theme-specific overrides -->
            <ResourceDictionary.ThemeDictionaries>
                <!-- Light Theme (Default) -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFF5F5F5" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FFECECEC" />
                    <SolidColorBrush x:Key="TabViewButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewButtonBackgroundPointerOver" Color="#FFE6E6E6" />
                    <SolidColorBrush x:Key="TabViewButtonBackgroundPressed" Color="#FFD3D3D3" />
                    <SolidColorBrush x:Key="TabViewButtonBackgroundSelected" Color="#FFF5F5F5" />
                    <SolidColorBrush x:Key="TabViewScrollButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewScrollButtonBackgroundPointerOver" Color="#FFE6E6E6" />
                    <SolidColorBrush x:Key="TabViewScrollButtonBackgroundPressed" Color="#FFD3D3D3" />
                    <SolidColorBrush x:Key="SystemAltMediumColorBrush" Color="#FFE6E6E6"/>
                    <SolidColorBrush x:Key="SystemAccentColorDark2" Color="#FF0063B1"/>
                    <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#FFF3F3F3"/>
                    <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#FFF3F3F3"/>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF0063B1"/>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#FF000000"/>
                </ResourceDictionary>

                <!-- Dark Theme -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF333333" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF2D2D2D" />
                    <SolidColorBrush x:Key="TabViewButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewButtonBackgroundPointerOver" Color="#FF444444" />
                    <SolidColorBrush x:Key="TabViewButtonBackgroundPressed" Color="#FF555555" />
                    <SolidColorBrush x:Key="TabViewButtonBackgroundSelected" Color="#FF333333" />
                    <SolidColorBrush x:Key="TabViewScrollButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewScrollButtonBackgroundPointerOver" Color="#FF444444" />
                    <SolidColorBrush x:Key="TabViewScrollButtonBackgroundPressed" Color="#FF555555" />
                    <SolidColorBrush x:Key="SystemAltMediumColorBrush" Color="#FF555555"/>
                    <SolidColorBrush x:Key="SystemAccentColorDark2" Color="#FF3399FF"/>
                    <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#FF2D2D2D"/>
                    <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#FF2D2D2D"/>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF3399FF"/>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#FFFFFFFF"/>
                </ResourceDictionary>

                <!-- High Contrast Theme -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TabViewButtonBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TabViewButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="TabViewButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="TabViewButtonBackgroundSelected" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TabViewScrollButtonBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TabViewScrollButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="TabViewScrollButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SystemAltMediumColorBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="SystemAccentColorDark2" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
